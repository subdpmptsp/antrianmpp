APP_NAME="Antrian MPP Siola"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
OPERATOR_PASSWORD_ROTATION_AFTER=2026-08-17T00:00:00+07:00
APP_URL=http://localhost:8000
FILESYSTEM_PUBLIC_URL=/storage

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS tidak didukung oleh PHP built-in server di Windows.
# Gunakan Apache/Nginx Laragon untuk pengujian beberapa perangkat sekaligus.

BCRYPT_ROUNDS=12
INITIAL_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antrianmpp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Petugas logout setelah tidak ada aktivitas manusia selama 60 menit,
# maksimal 12 jam, dan selalu diminta login kembali saat tanggal berganti.
OPERATOR_IDLE_TIMEOUT=60
OPERATOR_ABSOLUTE_SESSION=720

# Pembagian kolom instansi pada mesin pengambilan nomor antrian.
KIOSK_POPULAR_INSTITUTION_COUNT=6
# KIOSK_POPULAR_MINIMUM_TOTAL=40

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="antrian@example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Opsional: isi hanya jika nama counter zona di database tidak memakai ZONA 1-5.
TV_ZONE_1_COUNTER_ID=
TV_ZONE_2_COUNTER_ID=
TV_ZONE_3_COUNTER_ID=
TV_ZONE_4_COUNTER_ID=
TV_ZONE_5_COUNTER_ID=

# Aktifkan setelah token sudah dipasang pada semua perangkat.
DEVICE_AUTH_ENABLED=false
KIOSK_DEVICE_TOKEN=
TV_ZONE_1_TOKEN=
TV_ZONE_2_TOKEN=
TV_ZONE_3_TOKEN=
TV_ZONE_4_TOKEN=
TV_ZONE_5_TOKEN=
